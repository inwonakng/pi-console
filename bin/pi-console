#!/usr/bin/env bash

set -eu

usage() {
    printf 'Usage: %s [--overview | --sidebar | --new | --attach ID | --resume ID]\n' "${0##*/}" >&2
    printf '       %s tmux {setup|toggle|new|overview|sidebar} [ARGS...]\n' "${0##*/}" >&2
    printf '       [--cwd OWNER_PATH] [--root PATH | --remote HTTPS_ORIGIN --credential-file PATH [--ca-file PATH]]\n' >&2
    printf '       %s server {run|start|status|stop|restart|enable|disable|reconcile|list|create|resume|credentials} [OPTIONS]\n' "${0##*/}" >&2
    printf '       %s --version\n' "${0##*/}" >&2
    printf 'Local launches select the invocation directory; the first prompt or shell command creates a session.\n' >&2
    printf 'server enable --binary ABSOLUTE_PI [--path PATH] [--supervisor-dir DIR] enables login startup explicitly.\n' >&2
    printf 'stop/restart/disable refuse active work unless --force; idle sessions are stopped and saved.\n' >&2
    exit "${1:-2}"
}

script_path=$(realpath -- "${BASH_SOURCE[0]}")
script_dir=$(dirname -- "$script_path")
app_root=$(dirname -- "$script_dir")
source "$script_dir/channel-env.sh"
case "${1-}" in --help|-h) usage 0 ;; esac
if [ "${1-}" = server ]; then
    shift
    [ -f "$app_root/server/dist/cli.js" ] || { printf 'Service build missing. Rerun the installer, or in a source checkout: npm ci --prefix server && npm run build --prefix server\n' >&2; exit 1; }
    if [ -z "${PI_BINARY-}" ] && command -v pi >/dev/null 2>&1; then export PI_BINARY=$(command -v pi); fi
    exec node "$app_root/server/dist/cli.js" "$@"
fi

# Headless packaging still provides service administration and the direct Pi TUI.
if [ "$PI_CONSOLE_INSTALL_MODE" = server-only ] && [ "${1-}" != --version ]; then
    printf 'This is a server-only installation. Use server subcommands or pi-stable/pi-dev; rerun the installer with --full for Neovim/tmux.\n' >&2
    exit 1
fi

if [ "$#" -eq 1 ] && [ "$1" = --version ]; then
    pi_console_build_snapshot
    pi_console_version
    exit 0
fi

# Old persisted config entries must only apply bindings, never rewrite config
# while tmux is sourcing it. New user-facing commands use `tmux setup`.
if [ "$#" -eq 2 ] && [ "$1" = --tmux ] && [ "$2" = setup ]; then
    exec bash "$app_root/tmux/scripts/setup.sh" --apply
fi

if [ "${1-}" = "tmux" ]; then
    [ "$#" -ge 2 ] || usage
    action=$2
    shift 2
    case "$action" in
        setup)
            [ "$#" -eq 0 ] || usage
            exec bash "$app_root/tmux/scripts/setup.sh"
            ;;
        toggle)
            exec bash "$app_root/tmux/scripts/toggle-popup-agents.sh" "$@"
            ;;
        new)
            exec bash "$app_root/tmux/scripts/open-agents-window.sh" "$@"
            ;;
        overview)
            exec bash "$app_root/tmux/scripts/open-agents-overview.sh" "$@"
            ;;
        sidebar)
            exec bash "$app_root/tmux/scripts/toggle-sidebar.sh" "$@"
            ;;
        *)
            usage
            ;;
    esac
fi

unset PI_CONSOLE_SESSION PI_CONSOLE_SERVICE_NEW PI_CONSOLE_OVERVIEW PI_CONSOLE_SIDEBAR PI_CONSOLE_SERVICE_SESSION PI_CONSOLE_SERVICE_RESUME PI_CONSOLE_SERVICE_ROOT PI_CONSOLE_SERVICE_REMOTE PI_CONSOLE_SERVICE_CREDENTIAL_FILE PI_CONSOLE_SERVICE_CA_FILE PI_CONSOLE_SERVICE_CWD PI_CONSOLE_SERVICE_EXPECTED_HOST
selection=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --overview|--sidebar|--new|--attach|--resume)
            [ -z "$selection" ] || usage
            selection=$1 ;;
    esac
    case "$1" in
        --overview) export PI_CONSOLE_OVERVIEW=1; shift; continue ;;
        --sidebar) export PI_CONSOLE_SIDEBAR=1; shift; continue ;;
        --new) export PI_CONSOLE_SERVICE_NEW=1; shift; continue ;;
        --session) printf 'Legacy session files are not service identities. Use pi-stable/pi-dev --session PATH, or --resume SERVICE_SESSION_ID. No legacy data was adopted.\n' >&2; exit 2 ;;
    esac
    [ "$#" -ge 2 ] && [ -n "$2" ] || usage
    case "$1" in
        --attach) export PI_CONSOLE_SERVICE_SESSION=$2 ;;
        --resume) export PI_CONSOLE_SERVICE_SESSION=$2 PI_CONSOLE_SERVICE_RESUME=1 ;;
        --root) export PI_CONSOLE_SERVICE_ROOT=$2 ;;
        --remote) export PI_CONSOLE_SERVICE_REMOTE=$2 ;;
        --credential-file) export PI_CONSOLE_SERVICE_CREDENTIAL_FILE=$2 ;;
        --ca-file) export PI_CONSOLE_SERVICE_CA_FILE=$2 ;;
        --cwd) export PI_CONSOLE_SERVICE_CWD=$2 ;;
        --expected-host) export PI_CONSOLE_SERVICE_EXPECTED_HOST=$2 ;;
        *) usage ;;
    esac
    shift 2
done
if [ -n "${PI_CONSOLE_SERVICE_REMOTE-}" ]; then
    [ -n "${PI_CONSOLE_SERVICE_CREDENTIAL_FILE-}" ] && [ -z "${PI_CONSOLE_SERVICE_ROOT-}" ] || usage
else
    [ -z "${PI_CONSOLE_SERVICE_CREDENTIAL_FILE-}${PI_CONSOLE_SERVICE_CA_FILE-}" ] || usage
    # Explicit attachment/resume must not create a replacement owner, and may
    # intentionally view another compatible dev checkout's running service.
    if [ -z "${PI_CONSOLE_SERVICE_SESSION-}" ]; then
        start_args=(server start)
        if [ -n "${PI_CONSOLE_SERVICE_ROOT-}" ]; then start_args+=(--root "$PI_CONSOLE_SERVICE_ROOT"); fi
        bash "$script_path" "${start_args[@]}" >/dev/null
    fi
fi
[ -f "$app_root/server/dist/bridge.js" ] || { printf 'Service bridge missing. Rerun the installer or build server/.\n' >&2; exit 1; }

# A private handoff file lets Neovim request a relaunch without shell-parsing
# session paths or prompt text. Each launcher owns its own restart state.
restart_dir=$(mktemp -d "${TMPDIR:-/tmp}/pi-console-restart.XXXXXX")
trap 'rm -rf -- "$restart_dir"' EXIT
export PI_CONSOLE_RESTART_FILE="$restart_dir/request.json"

while :; do
    # A full restart takes a fresh build snapshot, including checkout edits.
    source "$script_dir/channel-env.sh"
    pi_console_build_snapshot
    export NVIM_APPNAME="$PI_CONSOLE_NVIM_APPNAME"
    if nvim -u "$app_root/nvim/init.lua"; then
        status=0
    else
        status=$?
    fi
    # A crashed editor cannot run VimLeavePre, and an interactive parent shell
    # may keep its tmux pane alive. Refresh saved tab state before returning to
    # that shell (also covering a full frontend restart).
    if [ -n "${TMUX-}" ]; then
        socket_path=${TMUX%,*}
        socket_path=${socket_path%,*}
        if ! nvim --headless -u NONE -i NONE -l "$app_root/tmux/scripts/refresh-tabs.lua" "$socket_path"; then
            printf 'pi-console: could not refresh tmux tabs after editor exit\n' >&2
        fi
    fi
    if [ "$status" -ne 0 ] || [ ! -f "$PI_CONSOLE_RESTART_FILE" ]; then
        exit "$status"
    fi
    # Consume the request before launching, so startup errors cannot turn a
    # single restart request into a relaunch loop.
    mv -- "$PI_CONSOLE_RESTART_FILE" "$PI_CONSOLE_RESTART_FILE.restore"
done
