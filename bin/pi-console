#!/usr/bin/env bash

set -eu

usage() {
    printf 'Usage: %s [--overview | --session PATH]\n' "${0##*/}" >&2
    printf '       %s --tmux {setup|toggle|new|overview} [ARGS...]\n' "${0##*/}" >&2
    exit 2
}

script_path=$(realpath -- "${BASH_SOURCE[0]}")
script_dir=$(dirname -- "$script_path")
app_root=$(dirname -- "$script_dir")

if [ "${1-}" = "--tmux" ]; then
    [ "$#" -ge 2 ] || usage
    action=$2
    shift 2
    case "$action" in
        setup)
            [ "$#" -eq 0 ] || usage
            exec tmux source-file "$app_root/tmux/pi-console.conf"
            ;;
        toggle)
            exec bash "$app_root/tmux/scripts/toggle-popup-agents.sh" "$@"
            ;;
        new)
            exec bash "$app_root/tmux/scripts/open-agents-window.sh" "$@"
            ;;
        overview)
            exec bash "$app_root/tmux/scripts/open-agents-overview.sh" "$@"
            ;;
        *)
            usage
            ;;
    esac
fi

unset PI_CONSOLE_OVERVIEW PI_CONSOLE_SESSION
export NVIM_APPNAME=pi-console-nvim

case "$#" in
    0)
        ;;
    1)
        [ "$1" = "--overview" ] || usage
        export PI_CONSOLE_OVERVIEW=1
        ;;
    2)
        [ "$1" = "--session" ] && [ -n "$2" ] || usage
        export PI_CONSOLE_SESSION=$2
        ;;
    *)
        usage
        ;;
esac

# A private handoff file lets Neovim request a relaunch without shell-parsing
# session paths or prompt text. Each launcher owns its own restart state.
restart_dir=$(mktemp -d "${TMPDIR:-/tmp}/pi-console-restart.XXXXXX")
trap 'rm -rf -- "$restart_dir"' EXIT
export PI_CONSOLE_RESTART_FILE="$restart_dir/request.json"

while :; do
    if nvim -u "$app_root/nvim/init.lua"; then
        status=0
    else
        status=$?
    fi
    if [ "$status" -ne 0 ] || [ ! -f "$PI_CONSOLE_RESTART_FILE" ]; then
        exit "$status"
    fi
    # Consume the request before launching, so startup errors cannot turn a
    # single restart request into a relaunch loop.
    mv -- "$PI_CONSOLE_RESTART_FILE" "$PI_CONSOLE_RESTART_FILE.restore"
done
